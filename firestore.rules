rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: own doc only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ChatGPT-style conversations — subcollection under user
      match /conversations/{convId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Messages inside a conversation
        match /messages/{msgId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Flat collections — create: use request.resource, read/update/delete: use resource
    match /chatbot_history/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /vocabulary_history/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /speaking_scores/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /lesson_completions/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /activity_log/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /study_plans/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /achievements/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
